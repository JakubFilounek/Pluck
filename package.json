{
  "name": "pluck",
  "description": "A local wishlist and favourites extension for two people sharing one Firefox profile.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt --browser firefox",
    "dev:chrome": "wxt",
    "build": "wxt build --browser firefox",
    "build:chrome": "wxt build",
    "zip": "wxt zip --browser firefox",
    "compile": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run compile && npm run test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.0.11"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.5",
    "@wxt-dev/module-svelte": "^2.0.2",
    "happy-dom": "^17.1.8",
    "svelte": "^5.20.4",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wxt": "^0.20.0"
  }
}
